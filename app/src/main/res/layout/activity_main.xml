<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/main" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/home_background" android:padding="12dp">

    <androidx.appcompat.widget.Toolbar android:id="@+id/mainToolbar" android:layout_width="match_parent" android:layout_height="?attr/actionBarSize" android:minHeight="?attr/actionBarSize" android:background="@color/home_toolbar_background" app:title="@string/app_name" app:titleTextColor="@color/home_title_color"/>

    <LinearLayout android:id="@+id/cardContextStrip" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:layout_marginBottom="12dp" android:minHeight="42dp" android:gravity="center_vertical" android:paddingStart="12dp" android:paddingEnd="12dp" android:background="@drawable/bg_card_context_strip" android:orientation="horizontal">
        <TextView android:id="@+id/textCollectionName" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:ellipsize="end" android:maxLines="1" android:textSize="14sp" android:textColor="?android:attr/textColorSecondary"/>
        <TextView android:id="@+id/textCardCounter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:textSize="14sp" android:textColor="?android:attr/textColorSecondary"/>
    </LinearLayout>

    <FrameLayout android:id="@+id/presentationStage" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginBottom="10dp"><LinearLayout android:id="@+id/cardContainer" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@drawable/bg_phrase_card" android:elevation="4dp" android:padding="20dp" android:clickable="true" android:longClickable="true" android:focusable="true">
        <TextView android:id="@+id/textLanguage" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="14sp" android:textStyle="bold" android:textColor="?attr/colorPrimary" android:paddingStart="48dp" android:paddingEnd="104dp"/>
        <TextView android:id="@+id/textPhrase" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center" android:textColor="?android:attr/textColorPrimary" android:textSize="32sp" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="18sp" android:autoSizeMaxTextSize="36sp" android:autoSizeStepGranularity="1sp"/>
        <TextView
            android:id="@+id/textQuantityValue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingTop="2dp"
            android:paddingBottom="4dp"
            android:textSize="36sp"
            android:textStyle="bold"
            android:visibility="gone"/>
        <TextView android:id="@+id/gestureHint" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="@string/card_gesture_hint_swipe" android:textSize="12sp" android:textColor="?android:attr/textColorSecondary"/>
    </LinearLayout>

    <ImageButton android:id="@+id/presentationBackButton"
        android:layout_width="48dp" android:layout_height="48dp"
        android:layout_gravity="top|start" android:layout_margin="6dp"
        android:padding="12dp" android:elevation="5dp"
        android:src="@drawable/ic_arrow_back_24"
        android:background="@drawable/bg_card_action_button"
        android:contentDescription="@string/show_mode_back"
        android:tint="@color/card_action_icon"
        android:visibility="gone" />

    <ImageButton android:id="@+id/presentationRotateButton"
        android:layout_width="48dp" android:layout_height="48dp"
        android:layout_gravity="top|end" android:layout_margin="6dp"
        android:padding="11dp" android:elevation="5dp"
        android:src="@drawable/ic_rotate_screen_24"
        android:background="@drawable/bg_card_action_button"
        android:contentDescription="@string/switch_to_landscape"
        android:tint="@color/card_action_icon"
        android:visibility="gone" />

    <ImageButton android:id="@+id/buttonShowCard"
        android:layout_width="48dp" android:layout_height="48dp"
        android:layout_gravity="bottom|start" android:layout_margin="6dp"
        android:padding="12dp" android:elevation="5dp"
        android:src="@drawable/ic_show_card_24"
        android:background="@drawable/bg_card_action_button"
        android:contentDescription="@string/show_card_button"
        android:tint="@color/card_action_icon"
        android:visibility="gone" />

    <ImageButton android:id="@+id/buttonFavorite"
        android:layout_width="48dp" android:layout_height="48dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="6dp" android:layout_marginEnd="114dp"
        android:padding="11dp" android:elevation="5dp"
        android:src="@drawable/ic_star_outline_24"
        android:background="@drawable/bg_card_action_button"
        android:contentDescription="@string/add_to_favorites"
        android:tint="@color/card_action_icon"
        android:visibility="gone" />

    <ImageButton android:id="@+id/buttonQueueSelect"
        android:elevation="5dp" android:layout_width="48dp"
        android:layout_height="48dp" android:layout_gravity="top|start"
        android:layout_margin="6dp" android:padding="11dp"
        android:src="@drawable/ic_queue_unchecked_24"
        android:background="@drawable/bg_card_action_button"
        android:contentDescription="@string/show_queue_select"
        android:tint="@color/card_action_icon" android:visibility="gone"/>

    <ImageButton android:id="@+id/buttonSpeakCardOverlay" android:elevation="5dp" android:padding="12dp" android:layout_width="48dp" android:layout_height="48dp" android:layout_gravity="top|end" android:layout_marginTop="6dp" android:layout_marginEnd="60dp" android:src="@drawable/ic_volume_24" android:background="@drawable/bg_card_action_button" android:contentDescription="@string/tts_speak" android:tint="@color/card_action_icon" android:clickable="true" android:focusable="true" android:visibility="gone"/>

    <ImageButton android:id="@+id/buttonDeleteCardOverlay" android:elevation="5dp" android:padding="12dp" android:layout_width="48dp" android:layout_height="48dp" android:layout_gravity="top|end" android:layout_marginTop="6dp" android:layout_marginEnd="6dp" android:src="@drawable/ic_close_24" android:background="@drawable/bg_card_action_button" android:contentDescription="@string/delete_card" android:tint="@color/card_action_icon" android:clickable="true" android:focusable="true"/>
    <Button
        android:id="@+id/buttonQuickVariables"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="bottom|end"
        android:layout_margin="6dp"
        android:elevation="5dp"
        android:padding="0dp"
        android:text="{ }"
        android:textSize="16sp"
        android:textAllCaps="false"
        android:textColor="@color/card_action_icon"
        android:background="@drawable/bg_card_action_button"
        android:contentDescription="@string/variables_quick_fill"
        android:visibility="gone" />
</FrameLayout>

    <LinearLayout android:id="@+id/yesNoResponseButtons" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="10dp" android:layout_marginBottom="4dp" android:visibility="gone">
        <Button android:id="@+id/buttonYesResponse" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:layout_marginEnd="6dp" android:text="@string/yes_no_yes" android:textAllCaps="false" android:background="@drawable/bg_card_secondary_button" android:backgroundTint="@null" android:textColor="@color/card_action_icon"/>
        <Button android:id="@+id/buttonNoResponse" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:layout_marginStart="6dp" android:text="@string/yes_no_no" android:textAllCaps="false" android:background="@drawable/bg_card_secondary_button" android:backgroundTint="@null" android:textColor="@color/card_action_icon"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/quantityControls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="4dp"
        android:visibility="gone">
        <Button
            android:id="@+id/buttonSetQuantity"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="@string/quantity_button"
            android:textAllCaps="false" android:background="@drawable/bg_card_secondary_button" android:backgroundTint="@null" android:textColor="@color/card_action_icon"/>
    </LinearLayout>

    <LinearLayout android:id="@+id/navigationButtons" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:visibility="gone">
        <Button android:id="@+id/buttonPrevious" android:layout_marginEnd="6dp" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:text="@string/previous_card" android:singleLine="true" android:ellipsize="end" android:textAllCaps="false" android:background="@drawable/bg_card_secondary_button" android:backgroundTint="@null" android:textColor="@color/card_action_icon"/>
        <Button android:id="@+id/buttonNext" android:layout_marginStart="6dp" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:text="@string/next_card" android:singleLine="true" android:ellipsize="end" android:textAllCaps="false" android:background="@drawable/bg_card_secondary_button" android:backgroundTint="@null" android:textColor="@color/card_action_icon"/>
    </LinearLayout>
</LinearLayout>
