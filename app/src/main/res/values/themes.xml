<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.Phrasoteca" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/button_primary_fill</item>
        <item name="colorPrimaryVariant">@color/button_primary_fill</item>
        <item name="colorOnPrimary">@color/button_primary_text</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/button_primary_fill</item>
        <item name="colorSecondaryVariant">@color/button_primary_fill</item>
        <item name="colorOnSecondary">@color/button_primary_text</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
        <!-- Customize your theme here. -->
        <item name="materialButtonStyle">@style/Widget.Phrasoteca.Button</item>
        <!-- All existing AppCompat AlertDialog.Builder instances use this overlay. -->
        <item name="alertDialogTheme">@style/ThemeOverlay.Phrasoteca.AlertDialog</item>
    </style>
    <!-- Light/dark dialog colors are provided by matching resource qualifiers. -->
    <style name="ThemeOverlay.Phrasoteca.AlertDialog" parent="ThemeOverlay.AppCompat.Dialog.Alert">
        <item name="android:windowBackground">@drawable/bg_phrasoteca_dialog</item>
        <item name="android:colorBackground">@color/dialog_surface</item>
        <item name="colorSurface">@color/dialog_surface</item>
        <item name="colorOnSurface">@color/dialog_text_primary</item>
        <item name="android:textColorPrimary">@color/dialog_text_primary</item>
        <item name="android:textColorSecondary">@color/dialog_text_secondary</item>
        <item name="colorAccent">@color/dialog_action</item>
        <item name="colorControlActivated">@color/dialog_action</item>
        <item name="colorControlNormal">@color/dialog_text_secondary</item>
    </style>
    <style name="Widget.Phrasoteca.Button" parent="Widget.MaterialComponents.Button">
        <item name="cornerRadius">16dp</item>
        <item name="backgroundTint">@color/button_primary_fill</item>
        <item name="android:textColor">@color/button_primary_text</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">48dp</item>
    </style>
</resources>